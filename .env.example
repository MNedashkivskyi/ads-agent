DATABASE_URL=postgresql+asyncpg://adcopilot:adcopilot@postgres:5432/adcopilot
REDIS_URL=redis://redis:6379/0
ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-secrets-generate
TOKEN_ENCRYPTION_KEY=change-me-32-bytes-base64-encoded=

# Supabase auth — JWKS is the recommended approach (no shared secret needed).
# The backend fetches public keys from Supabase and verifies tokens with RS256/ES256.
SUPABASE_JWKS_URL=https://oflhriqtqtoucpprywon.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://oflhriqtqtoucpprywon.supabase.co/auth/v1
# Legacy fallback — only needed if JWKS is not available.
# SUPABASE_JWT_SECRET=

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Where Google redirects after OAuth consent. MUST be your real API domain in
# production (not localhost) and registered in Google Cloud Console.
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback
GA4_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/ga4/callback
# Public URL of the web application — used in re-auth deep-links + CORS.
APP_URL=
LLM_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# One-time campaign setup fee (only needed if the launch wizard is enabled).
STRIPE_SETUP_FEE_PRICE_ID=

# Comma-separated user UUIDs allowed to access /api/admin/* (empty = no admins).
ADMIN_USER_IDS=
# Optional — Google PageSpeed Insights API key (degrades gracefully if unset).
PAGESPEED_API_KEY=

# Cloudflare R2 — nightly Postgres backups (30-day retention).
# Create an R2 bucket named "adcopilot-backups" and an API token with
# Object Read & Write permissions, then fill in the values below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=adcopilot-backups

# Sentry observability.  Leave SENTRY_DSN empty to disable Sentry entirely.
# Traces sample rate controls performance tracing for the hot paths
# (snapshot / detection / execute / telegram callbacks); 0.0-1.0.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional — override the release version sent to Sentry.  If unset we fall
# back to RAILWAY_GIT_COMMIT_SHA, then GIT_SHA, then `git rev-parse HEAD`.
SENTRY_RELEASE=

# --- Campaign Intelligence Engine (CIE) -------------------------------------
# DataForSEO — exact search-volume fallback + keyword expansion. Optional:
# when unset the CIE uses Keyword Planner only (no exact fallback, no expansion).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Feature flag + per-run cost guard for reality-grounded keyword expansion.
ENABLE_KEYWORD_EXPANSION=false
KEYWORD_EXPANSION_MAX_REQUESTS=3
# Min monthly searches for a keyword to be considered viable.
KEYWORD_MIN_VIABLE_VOLUME=10
# Validated-volume cache TTL (seconds) — 30 days (cross-client cache).
KEYWORD_VOLUME_CACHE_TTL_SECONDS=2592000
# Generation cache TTL (seconds) for near-identical (service, problems) inputs.
GENERATION_CACHE_TTL_SECONDS=604800
