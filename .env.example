DATABASE_URL=postgresql+asyncpg://adcopilot:adcopilot@postgres:5432/adcopilot
REDIS_URL=redis://redis:6379/0
ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-secrets-generate
TOKEN_ENCRYPTION_KEY=change-me-32-bytes-base64-encoded=

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
# Public base URL of this service used to register the Telegram webhook.
# Example: https://app.example.com
# Leave empty for local development (polling mode via scripts/run_bot.py).
TELEGRAM_WEBHOOK_URL=
# Shared secret Telegram echoes in the X-Telegram-Bot-Api-Secret-Token
# header on every webhook request.  Leave empty to fall back to an HMAC
# of TELEGRAM_BOT_TOKEN — recommended to set explicitly in production
# so rotating the webhook secret is independent of rotating the bot token.
TELEGRAM_WEBHOOK_SECRET=
# Public URL of the web application — used in Telegram re-auth deep-links.
APP_URL=
LLM_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Cloudflare R2 — nightly Postgres backups (30-day retention).
# Create an R2 bucket named "adcopilot-backups" and an API token with
# Object Read & Write permissions, then fill in the values below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=adcopilot-backups

# Sentry observability.  Leave SENTRY_DSN empty to disable Sentry entirely.
# Traces sample rate controls performance tracing for the hot paths
# (snapshot / detection / execute / telegram callbacks); 0.0-1.0.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional — override the release version sent to Sentry.  If unset we fall
# back to RAILWAY_GIT_COMMIT_SHA, then GIT_SHA, then `git rev-parse HEAD`.
SENTRY_RELEASE=
